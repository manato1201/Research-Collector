{
  // ResearchBroadcast(取り込み・記事API・episode・ボード・サイト)。ResearchBroadcast_DESIGN.md §3・§9 参照。
  // **無料プランで動く構成**: Worker + D1 + 静的アセットのみ(R2・Containers・Workflows・Workers AI は使わない)。
  //
  // 秘密情報はここに書かない(ローカルは .dev.vars):
  //   wrangler secret put INGEST_TOKEN    ... 機械(GitHub Actions)用。取り込みの Bearer トークン
  // 人(ブラウザ)のログインは Cloudflare Access(README「人のログイン」)。パスワードは使わない
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "research-broadcast",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],

  // サイトの本体(HTML/JS/CSS)。静的アセットの配信は無料・無制限。/api/* だけが Worker で動く
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // "false" にすると /api/* の読み出し・ボードをログイン無しで使える。Cloudflare Access が、このWorkerの
    // 全ホスト名(workers.dev を含む)を保護していると確認できたときだけ変更すること。
    "READ_REQUIRES_TOKEN": "true",
    // ---- 複数人で使う(Cloudflare Access)。README「人のログイン」参照。3 つとも設定したときだけ有効。
    // Zero Trust でこの Worker を「Self-hosted application」として保護し(workers.dev も含める)、
    //   CF_ACCESS_TEAM_DOMAIN = <チーム名>.cloudflareaccess.com
    //   CF_ACCESS_AUD         = そのアプリケーションの Application Audience (AUD) Tag
    //   ACCESS_ALLOWED_EMAILS = このサイトを使ってよい人のメールアドレス(カンマ区切り)。載っていない人は、Access を通っても 403
    // 秘密ではない値なので vars でよい(メールアドレスを公開リポジトリに入れたくないときは、wrangler secret put ACCESS_ALLOWED_EMAILS)。
    // "CF_ACCESS_TEAM_DOMAIN": "",
    // "CF_ACCESS_AUD": "",
    // "ACCESS_ALLOWED_EMAILS": "",
    // 記事・日次 episode の保持日数(設計 §4.3。articles_log.json と同じ90日)
    "RETENTION_DAYS": "90"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "research-broadcast",
      // `wrangler d1 create research-broadcast` の出力のID(秘密ではない。ID だけでは DB を操作できない)
      "database_id": "42851536-a580-4355-90a8-c6e897c29a0e",
      "migrations_dir": "./migrations"
    }
  ],

  // 解説(これは何か・何ができるか・どう応用できるか)の生成。Workers AI の無料枠(1日 10,000 Neurons)の範囲。
  // モデルは、環境変数 INSIGHT_MODEL で差し替えられる(既定: @cf/qwen/qwen3-30b-a3b-fp8。評価は DOCUMENT.md 12.17)
  "ai": { "binding": "AI", "remote": true },

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
